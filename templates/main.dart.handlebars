part of '{{file_name}}';

{{#each classes}}
// ------------------------------------------------------------
{{#if is_mixin}}
mixin {{class_name}}CopyWith{{{type_params}}} {
  {{#each fields}}
  {{{type_str_nullable}}} get {{name_str}};
  {{/each}}

  {{{class_type}}} copyWith({
    {{#each fields}}
    {{{type_str_wrapped_nullable_value}}} {{name_str}},
    {{/each}}
  }) => {{{constructor}}}(
    {{#each fields}}
    {{#unless is_positional}}{{{name_str}}}: {{/unless}}{{name_str}} {{#if is_nullable}}|{{else}}??{{/if}} this.{{name_str}},
    {{/each}}
  );
}
{{else if is_nullable_value}}
extension {{class_name}}CopyWith{{{type_params}}} on {{{class_type}}} {
  {{{class_type}}} copyWith({
    {{#each fields}}
    {{{type_str_wrapped_nullable_value}}} {{name_str}},
    {{/each}}
  }) => {{{constructor}}}(
    {{#each fields}}
    {{#unless is_positional}}{{{name_str}}}: {{/unless}}{{name_str}} {{#if is_nullable}}|{{else}}??{{/if}} this.{{name_str}},
    {{/each}}
  );
}
{{else}}
extension {{class_name}}CopyWith{{{type_params}}} on {{{class_type}}} {
  {{{class_type}}} Function({
    {{#each fields}}
    {{{type_str_nullable}}} {{name_str}},
    {{/each}}
  }) get copyWith => ({
        {{#each fields}}
        Object? {{name_str}} = Never,
        {{/each}}
      }) =>
          {{{constructor}}}(
            {{#each fields}}
            {{#unless is_positional}}{{{name_str}}}: {{/unless}}{{name_str}}._or(this.{{name_str}}),
            {{/each}}
          );
}
{{/if}}
{{/each}}
